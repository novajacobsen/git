[alias]
  br = branch
  brd = branch -d
  brD = branch -D
  brda = !git for-each-ref --format '%(refname:short)' refs/heads | grep -v dev | xargs git branch -D
  cc = "!f() { git clean -df -- \"./$1\" && git restore -- \"./$1\" && git status; }; f"
  co = checkout
  cob = checkout -b
  coo = !git fetch && git checkout
  dev = !git checkout dev && git pull
  merged = branch --merged
  st = status
  undelete = "!f() { git reset -- \"$1\" && git checkout -- \"$1\"; }; f"
[diff]
  tool = vimdiff
[difftool]
  prompt = false
[difftool "vimdiff"]
  cmd = vimdiff \"$LOCAL\" \"$REMOTE\"
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
